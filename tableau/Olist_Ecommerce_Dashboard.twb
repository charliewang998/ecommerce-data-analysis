  <worksheets>
    <worksheet name='Delivery &amp; Reviews'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='14'>Average Review Score by Delivery Status</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='olist_orders_dataset.csv+ (多个连接)' name='federated.0f3vmxe1cuynbd17z6uzw0uk98rn' />
          </datasources>
          <datasource-dependencies datasource='federated.0f3vmxe1cuynbd17z6uzw0uk98rn'>
            <column caption='Delivery Status' datatype='string' name='[Calculation_4876527415988226]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([order_delivered_customer_date])&#10;OR ISNULL([order_estimated_delivery_date]) THEN&#10;    NULL&#10;ELSEIF DATE([order_delivered_customer_date])&#10;    &lt;= DATE([order_estimated_delivery_date]) THEN&#10;    &quot;On time&quot;&#10;ELSE&#10;    &quot;Late&quot;&#10;END' />
            </column>
            <column-instance column='[review_score]' derivation='Avg' name='[avg:review_score:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_4876527415988226]' derivation='None' name='[none:Calculation_4876527415988226:nk]' pivot='key' type='nominal' />
            <column-instance column='[order_status]' derivation='None' name='[none:order_status:nk]' pivot='key' type='nominal' />
            <column caption='Order Delivered Customer Date' datatype='datetime' name='[order_delivered_customer_date]' role='dimension' type='ordinal' />
            <column caption='Order Estimated Delivery Date' datatype='datetime' name='[order_estimated_delivery_date]' role='dimension' type='ordinal' />
            <column caption='Order Status' datatype='string' name='[order_status]' role='dimension' type='nominal' />
            <column caption='Review Score' datatype='integer' name='[review_score]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0f3vmxe1cuynbd17z6uzw0uk98rn].[none:Calculation_4876527415988226:nk]'>
            <groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='member' level='[none:Calculation_4876527415988226:nk]' member='&quot;Late&quot;' />
              <groupfilter function='member' level='[none:Calculation_4876527415988226:nk]' member='&quot;On time&quot;' />
            </groupfilter>
          </filter>
          <filter class='categorical' column='[federated.0f3vmxe1cuynbd17z6uzw0uk98rn].[none:order_status:nk]'>
